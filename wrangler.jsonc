{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the Worker name you choose in the Cloudflare dashboard
  "name": "edgedesk",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // the Worker only runs for the API; everything else is served straight from public/
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "edgedesk",
      // ⬇ paste the Database ID from Cloudflare → Storage & Databases → D1 → edgedesk
      "database_id": "80f4e438-5ee1-4790-9b91-a8e3cec8942e"
    }
  ],
  "observability": { "enabled": true }
}
